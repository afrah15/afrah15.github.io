# Load reticulate to enable interoperability between R and Python
library(reticulate)
library(ggplot2)
library(dplyr)
reticulate::repl_python()
# INCORRECT (Triggers NameError/object not found)
#py_r2 <- r_squared
# CORRECT
py_r2 <- py$r_squared
reticulate::repl_python()
#| label: r-data-access
# Access Python objects in R using py$
penguins_r <- py$penguins_py
py_slope <- py$slope
py_intercept <- py$intercept
py_r2 <- py$r_squared
# Summarize metrics transferred from Python
metrics_summary <- data.frame(
Metric = c("Slope (g/mm)", "Intercept (g)", "R-squared"),
Value = round(c(py_slope, py_intercept, py_r2), 3)
)
knitr::kable(metrics_summary, caption = "Model Coefficients Computed in Python and Transferred to R")
#| label: fig-residual-plot
#| fig-cap: "Residual diagnostic plot rendered using ggplot2 in R from predicted values generated by scikit-learn in Python."
ggplot(penguins_r, aes(x = predicted_mass_g, y = residual_g, color = species)) +
geom_point(alpha = 0.7, size = 2.5) +
geom_hline(yintercept = 0, linetype = "dashed", color = "darkgrey") +
theme_minimal() +
labs(
title = "Model Residuals vs. Fitted Values",
subtitle = paste("R-squared =", round(py_r2, 3), "(Computed via Scikit-Learn)"),
x = "Predicted Body Mass (g)",
y = "Residuals (g)",
color = "Species"
)
